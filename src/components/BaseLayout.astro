---
import ThemeToggle from "./ThemeToggle";
import CodeBlockWrapper from "./CodeBlockWrapper.astro";
import "../styles/global.css";
import { profile } from "../data/profile";
import crypto from "node:crypto";

interface Props {
  title: string;
  description: string;
  image?: string;
  navVariant?: "patel" | "me";
}

const { title, description, image, navVariant = "patel" } = Astro.props;
const site_title = navVariant === "me" ? "Ayman Patel" : "Patel of Thought";
const site_label = navVariant === "me" ? "~/me" : site_title;
const site_href = navVariant === "me" ? "/me" : "/";
const site_description = navVariant === "me"
  ? "Staff Software Engineer. Building thoughtful systems, pragmatic platforms, and tools for people who ship."
  : "Long-form engineering notes, pragmatic systems thinking, and video walkthroughs for people who ship.";
const site_url = import.meta.env.PUBLIC_SITE_URL || "https://patelofthought.com";
const asset_version = "rocket-v1";
const favicon_path = `/favicon_21_9.png?v=${asset_version}`;
const site_origin = site_url.replace(/\/$/, "");
const preview_image = image || favicon_path;
const preview_image_base = preview_image.startsWith("http")
  ? preview_image
  : `${site_origin}${preview_image.startsWith("/") ? preview_image : `/${preview_image}`}`;

// Robust OG image cache busting: per-build random hex + epoch seconds
const og_cache_buster = `${Date.now().toString(36)}-${crypto.randomBytes(4).toString("hex")}`;
const preview_image_url = preview_image_base.includes("?")
  ? `${preview_image_base}&cb=${og_cache_buster}`
  : `${preview_image_base}?cb=${og_cache_buster}`;

// Avoid redundant titles when the page title already matches the site name
const normalized_title = title?.trim() ?? "";
const title_text = normalized_title && normalized_title.toLowerCase() !== site_title.toLowerCase()
  ? `${normalized_title} | ${site_title}`
  : site_title;

// Canonical URL for the current page (critical for LinkedIn / X card scraping)
const canonical_path = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonical_url = `${site_origin}${canonical_path}`;

const navLinks =
  navVariant === "me"
    ? [
        { label: "Blog", href: profile.links.blog, external: false },
        { label: "Projects", href: "/me#projects", external: false },
      ]
    : [
        {
          label: "Me",
          href: "/me",
          external: false,
        },
        {
          label: "Blog",
          href: profile.links.blog,
          external: false,
        },
      ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" sizes="any" href={favicon_path} />
    <link rel="apple-touch-icon" href={favicon_path} />
    <meta name="generator" content={Astro.generator} />

    <title>{title_text}</title>
    <meta name="description" content={description || site_description} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site_title} />
    <meta property="og:title" content={title_text} />
    <meta property="og:description" content={description || site_description} />
    <meta property="og:url" content={canonical_url} />
    <meta property="og:image" content={preview_image_url} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:domain" content={site_origin.replace(/^https?:\/\//, "")} />
    <meta name="twitter:url" content={canonical_url} />
    <meta name="twitter:title" content={title_text} />
    <meta name="twitter:description" content={description || site_description} />
    <meta name="twitter:image" content={preview_image_url} />
    <meta name="twitter:image:alt" content={title_text} />

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const theme = savedTheme || "dark";
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <CodeBlockWrapper>
      <header class="site-header">
        <div class="container nav">
          <a href={site_href} class="site-title">{site_label}</a>
          <nav class="nav-links">
            {navLinks.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
              >
                {link.label}
              </a>
            ))}
            <ThemeToggle client:load />
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container">
          <p class="text-secondary text-small">
            © {new Date().getFullYear()} {site_title}. Built with
            <a href="https://astro.build">Astro</a>.
          </p>
        </div>
      </footer>
    </CodeBlockWrapper>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg);
  }

  .site-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-text);
  }

  .site-title:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--font-size-sm);
  }

  .nav-links a {
    color: var(--color-text-secondary);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  :global(.theme-toggle) {
    background: rgba(229, 9, 20, 0.08);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 0.35rem 0.55rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: var(--font-size-xs);
    font-weight: 700;
    cursor: pointer;
    transition: border-color var(--transition-fast),
      background-color var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
  }

  :global(.theme-toggle:hover) {
    border-color: var(--color-accent);
    background-color: var(--color-bg-secondary);
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    margin-top: var(--space-2xl);
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
</style>
