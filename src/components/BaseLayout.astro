---
import ThemeToggle from "./ThemeToggle";
import CodeBlockWrapper from "./CodeBlockWrapper.astro";
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title: string;
  description: string;
  navVariant?: "patel" | "me";
}

const { title, description, navVariant = "patel" } = Astro.props;
const site_title = navVariant === "me" ? "Ayman Patel1" : "Patel of thought";
const site_href = navVariant === "me" ? "me" : "/";
const site_description = navVariant === "me" ? "Ayman's Portfolio" : "Patel of thought platform";
const site_url = import.meta.env.PUBLIC_SITE_URL || "https://patelofthought.com";
const title_text = title ? `${title} | ${site_title}` : site_title;

const navLinks =
  navVariant === "me"
    ? [
        { label: "Blog", href: profile.links.blog },
        {
          label: "GitHub",
          href: profile.links.github,
          icon: "github",
          external: true,
        },
        {
          label: "LinkedIn",
          href: profile.links.linkedin,
          icon: "linkedin",
          external: true,
        },
      ]
    : [
        {
          label: "YouTube",
          href: profile.links.youtube,
          external: true,
        },
        {
          label: "Blog",
          href: profile.links.blog,
        },
      ];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title_text}</title>
    <meta name="description" content={description || site_description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title_text} />
    <meta property="og:description" content={description || site_description} />
    <meta property="og:url" content={site_url} />
    <meta
      property="og:image"
      content="https://pub-76bbddc57c3f4070b6443ac3e2752cad.r2.dev/PatelofThoughtFavicon.png"
    />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title_text} />
    <meta name="twitter:description" content={description || site_description} />
    <meta
      name="twitter:image"
      content="https://pub-76bbddc57c3f4070b6443ac3e2752cad.r2.dev/PatelofThoughtFavicon.png"
    />

    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const prefersDark = window.matchMedia(
        "(prefers-color-scheme: dark)",
      ).matches;
      const theme = savedTheme || (prefersDark ? "dark" : "light");
      document.documentElement.setAttribute("data-theme", theme);
    </script>
  </head>
  <body>
    <CodeBlockWrapper>
      <header class="site-header">
        <div class="container nav">
          <a href={site_href} class="site-title">{site_title}</a>
          <nav class="nav-links">
            {navLinks.map((link) => (
              <a
                href={link.href}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
              >
                {link.icon === "github" && (
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.532 1.033 1.532 1.033.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.03-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.56 9.56 0 0 1 2.504.337c1.909-1.296 2.748-1.026 2.748-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.337-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z" />
                  </svg>
                )}
                {link.icon === "linkedin" && (
                  <svg
                    class="icon"
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                  >
                    <path d="M4.98 3.5c0 1.38-1.11 2.5-2.48 2.5C1.11 6 0 4.88 0 3.5 0 2.12 1.11 1 2.5 1 3.87 1 4.98 2.12 4.98 3.5ZM0.5 8h4V24h-4V8Zm7.5 0h3.83v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.77 2.65 4.77 6.1V24h-4v-7.6c0-1.81-.03-4.14-2.52-4.14-2.53 0-2.92 1.98-2.92 4.02V24h-4V8Z" />
                  </svg>
                )}
                {link.label}
              </a>
            ))}
            <ThemeToggle client:load />
          </nav>
        </div>
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <div class="container">
          <p class="text-secondary text-small">
            © {new Date().getFullYear()} {site_title}. Built with
            <a href="https://astro.build">Astro</a>.
          </p>
        </div>
      </footer>
    </CodeBlockWrapper>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(12px);
    background: color-mix(in srgb, var(--color-bg) 85%, transparent);
    border-bottom: 1px solid var(--color-border);
  }

  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--space-lg) 0;
  }

  .site-title {
    font-size: var(--font-size-xl);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .site-title:hover {
    text-decoration: none;
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    font-size: var(--font-size-sm);
  }

  .nav-links a {
    color: var(--color-text-secondary);
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  :global(.theme-toggle) {
    background: none;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    padding: 0.35rem 0.55rem;
    font-size: var(--font-size-lg);
    cursor: pointer;
    transition: border-color var(--transition-fast),
      background-color var(--transition-fast);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
  }

  :global(.theme-toggle:hover) {
    border-color: var(--color-accent);
    background-color: var(--color-bg-secondary);
  }

  main {
    min-height: 60vh;
  }

  .site-footer {
    margin-top: var(--space-2xl);
    padding: var(--space-2xl) 0;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }
</style>
