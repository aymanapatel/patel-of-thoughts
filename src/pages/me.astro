---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { profile } from "../data/profile";
import { testimonials } from "../data/testimonials";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjects = projects.filter((project) => project.data.showcase);
const otherProjects = projects.filter((project) => !project.data.showcase);

const showcasePosts = (
  await getCollection("posts", ({ data }) => !data.draft && data.showcase)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
}

function shortSlug(slug: string): string {
  return slug.split("/").pop() || slug;
}

const techStack = [
  {
    name: "Frontend",
    items: [
      { label: "React", icon: "react" },
      { label: "TypeScript", icon: "typescript" },
      { label: "Redux Toolkit", icon: "redux" },
      { label: "RTK Query", icon: "redux" },
      { label: "Next.js", icon: "nextjs" },
      { label: "Vite", icon: "vitejs" },
      { label: "Webpack", icon: "webpack" },
      { label: "Module Federation", icon: "webpack" },
      { label: "Figma", icon: "figma" },
    ],
  },
  {
    name: "Backend",
    items: [
      { label: "Spring", icon: "spring" },
      { label: "Spring Data JPA", icon: "spring" },
      { label: "Hibernate", icon: "hibernate" },
      { label: "Java", icon: "java" },
      { label: "Python", icon: "python" },
      { label: "Go", icon: "go" },
      { label: "FastAPI", icon: "fastapi" },
      { label: "Django", icon: "django" },
      { label: "Quarkus", icon: "quarkus" },
      { label: "REST APIs", icon: null },
      { label: "Microservices", icon: null },
      { label: "Event Sourcing", icon: null },
      { label: "CQRS", icon: null },
    ],
  },
  {
    name: "Databases & Events",
    items: [
      { label: "PostgreSQL", icon: "postgresql" },
      { label: "Oracle", icon: "oracle" },
      { label: "MongoDB", icon: "mongodb" },
      { label: "Redis", icon: "redis" },
      { label: "Kafka", icon: "apachekafka" },
      { label: "RabbitMQ", icon: "rabbitmq" },
      { label: "Debezium", icon: null },
      { label: "CDC", icon: null },
    ],
  },
  {
    name: "Cloud & DevOps",
    items: [
      { label: "AWS", icon: null },
      { label: "Docker", icon: "docker" },
      { label: "Kubernetes", icon: "kubernetes" },
      { label: "Terraform", icon: "terraform" },
      { label: "Localstack", icon: null },
      { label: "Jenkins", icon: "jenkins" },
      { label: "Gradle", icon: "gradle" },
    ],
  },
  {
    name: "AI / ML",
    items: [
      { label: "PyTorch", icon: "pytorch" },
      { label: "LLM APIs", icon: null },
      { label: "Langchain", icon: null },
      { label: "Llamaindex", icon: null },
      { label: "Chroma", icon: null },
      { label: "RAG", icon: null },
      { label: "Vector Databases", icon: null },
      { label: "Transformers", icon: null },
      { label: "LoRA", icon: null },
      { label: "Pandas", icon: "pandas" },
      { label: "DuckDB", icon: "duckdb" },
      { label: "Parquet", icon: null },
    ],
  },
  {
    name: "Observability & Testing",
    items: [
      { label: "Grafana", icon: "grafana" },
      { label: "Prometheus", icon: "prometheus" },
      { label: "Splunk", icon: null },
      { label: "Dynatrace", icon: "dynatrace" },
      { label: "OpenTelemetry", icon: "opentelemetry" },
      { label: "eBPF", icon: null },
      { label: "JUnit", icon: "junit" },
      { label: "Jest", icon: null },
      { label: "RTL", icon: "react" },
      { label: "Cypress", icon: null },
      { label: "Playwright", icon: "playwright" },
      { label: "Testcontainers", icon: null },
    ],
  },
  {
    name: "Workflow tools, Product Analytics and CDNs",
    items: [
      { label: "Camunda", icon: null },

      { label: "Mixpanel", icon: null },
      { label: "Cloudflare", icon: "cloudflare" },
      { label: "Akamai", icon: null },
      { label: "Posthog", icon: null },
    ],
  },
];
---

<BaseLayout title="Ayman Patel" description="A tech platform for learners and builders." image="/favicon_21_9.png" navVariant="me">
  <div class="hero">
    <div class="container hero-grid">
      <div class="hero-card">
        <div class="hero-card-inner hero-terminal">
          <div class="terminal-bar" aria-hidden="true">
            <span class="terminal-dot dot-red"></span>
            <span class="terminal-dot dot-yellow"></span>
            <span class="terminal-dot dot-green"></span>
            <span class="terminal-title">root@aymanpatel:~</span>
             </div>
          <p class="terminal-muted">[system] boot sequence complete.</p>
          <p class="terminal-muted">[system] interface loaded in silent mode.</p>
          <p class="terminal-command">
            <span class="terminal-prompt">&gt;</span> whoami
          </p>
          <p class="terminal-info">
            [info] {profile.role}. {profile.tagline}
          </p>
          <p class="terminal-command">
            <span class="terminal-prompt">&gt;</span> open /socials
          </p>
          <div class="terminal-socials" aria-label="Social links">
            <a
              class="terminal-button"
              href={profile.links.github}
              target="_blank"
              rel="noreferrer"
              onclick="window.posthog?.capture('social_link_clicked', { platform: 'github' })"
            >
              <svg class="terminal-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.532 1.033 1.532 1.033.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.03-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.56 9.56 0 0 1 2.504.337c1.909-1.296 2.748-1.026 2.748-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.337-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"/>
              </svg>
              GitHub
            </a>
            <a
              class="terminal-button"
              href={profile.links.linkedin}
              target="_blank"
              rel="noreferrer"
              onclick="window.posthog?.capture('social_link_clicked', { platform: 'linkedin' })"
            >
              <svg class="terminal-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M4.98 3.5c0 1.38-1.11 2.5-2.48 2.5C1.11 6 0 4.88 0 3.5 0 2.12 1.11 1 2.5 1 3.87 1 4.98 2.12 4.98 3.5ZM0.5 8h4V24h-4V8Zm7.5 0h3.83v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.77 2.65 4.77 6.1V24h-4v-7.6c0-1.81-.03-4.14-2.52-4.14-2.53 0-2.92 1.98-2.92 4.02V24h-4V8Z"/>
              </svg>
              LinkedIn
            </a>
            <a
              class="terminal-button"
              href={profile.links.twitter}
              target="_blank"
              rel="noreferrer"
              onclick="window.posthog?.capture('social_link_clicked', { platform: 'x' })"
            >
              X
            </a>
            <!-- <a
              class="terminal-button"
              href={profile.links.youtube}
              target="_blank"
              rel="noreferrer"
            >
              YouTube
            </a> -->
          </div>
          <p class="terminal-command">
            <span class="terminal-prompt">&gt;</span> open /portfolio
          </p>
          <div class="terminal-actions" aria-label="Portfolio links">
            <a class="terminal-action" href={profile.links.blog}>
              Blog
              <span class="button-arrow" aria-hidden="true">-&gt;</span>
            </a>
            <a class="terminal-action" href="/me#projects">
              Projects
              <span class="button-arrow" aria-hidden="true">-&gt;</span>
            </a>
            <a class="terminal-action terminal-action-light" href={profile.links.cv} target="_blank" rel="noreferrer"
               onclick="window.posthog?.capture('cv_clicked')">
              Open CV
              <span class="button-arrow" aria-hidden="true">-&gt;</span>
            </a>
          </div>
          <p class="terminal-command terminal-cursor-line">
            <span class="terminal-prompt">&gt;</span> _
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="container content-stack">

    <Section id="blog-showcase" title="Blog Showcase" subtitle="Deep dives, systems thinking, and engineering notes.">
      <div class="card-grid">
        {showcasePosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/posts/${shortSlug(post.slug)}`}
            cover={post.data.cover}
            date={formatDate(post.data.date)}
            tags={post.data.tags}
          />
        ))}
      </div>
      <div class="section-cta">
        <a class="button cta-dark" href={profile.links.blog}>
          Read the blog
          <span class="button-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </Section>

    <Section id="tech-stack" title="Tech Stack" subtitle="Languages, frameworks, and tools I use to ship.">
      <div class="tech-summary-pills">
        {techStack.map((category) => (
          <span class="pill pill-accent">{category.name}</span>
        ))}
      </div>
      <div class="tech-grid">
        {techStack.map((category) => (
          <div class="tech-card">
            <h3 class="tech-card-title">{category.name}</h3>
            <div class="tech-pills">
              {category.items.map((item) => (
                <span class="pill">
                  {item.icon && <img class="tech-icon" src={`https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/${item.icon}/${item.icon}${item.icon === 'django' ? '-plain' : '-original'}.svg`} alt="" width="14" height="14" loading="lazy" />}
                  {item.label}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>
    </Section>


  </div>

  <section class="tl-section" id="career-timeline">
    <div class="tl-wrapper">
      <div class="tl-header">
        <h2 class="tl-section-title">Timeline</h2>
        <p class="tl-section-sub">Education &amp; experience, newest first.</p>
      </div>
      <div class="tl-track">
        <div class="tl-center-line" aria-hidden="true"></div>
        {profile.timeline.map((item, i) => (
          <div class="tl-entry" data-tl-entry data-side={i % 2 === 0 ? 'right' : 'left'}>
            <div class="tl-card-wrap">
              <div class="tl-card">
                <h3 class="tl-card-title">{item.title}</h3>
                <p class="tl-card-org">{item.org}</p>
                <p class="tl-card-dates">{item.start}&nbsp;–&nbsp;{item.end}</p>
                <p class="tl-card-desc">{item.description}</p>
              </div>
            </div>
            <div class="tl-node-wrap">
              <div class="tl-node">
                <span class="tl-node-num">{i + 1}</span>
              </div>
            </div>
            <div class="tl-spacer"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container content-stack">

    <Section
      id="recommendations"
      className="recommendations-section"
      title="Recommendations"
      subtitle="Recommendations from my colleagues and managers"
    >
      <input
        class="testimonials-toggle"
        type="checkbox"
        id="toggle-testimonials"
      />
      <div class="testimonials-grid">
        {testimonials.map((item) => (
          <article class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">{item.image ? <img src={item.image} alt={item.name} /> : item.initials}</div>
              <div class="testimonial-identity">
                <p class="testimonial-name">{item.name}</p>
                <p class="testimonial-role text-secondary">{item.role}</p>
                <p class="testimonial-meta">{item.relationship}</p>
              </div>
              <span class="pill pill-muted">{item.date}</span>
            </div>
            <p class="testimonial-quote">"{item.quote}"</p>
            <div class="testimonial-footer">
              <span class="testimonial-source">LinkedIn recommendation</span>
            </div>
          </article>
        ))}
      </div>
      <div class="testimonials-actions">
        <label class="button ghost testimonials-toggle-btn" for="toggle-testimonials">
          <span class="label-more">Show more</span>
          <span class="label-less">Show less</span>
        </label>
      </div>
    </Section>
    <Section id="projects" title="Projects" subtitle="Work that goes deep.">
      <div class="card-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/projects/${shortSlug(project.slug)}`}
            cover={project.data.cover}
            tags={project.data.tags}
            stack={project.data.stack}
            role={project.data.role}
            github={project.data.github}
            live={project.data.live}
          />
        ))}
      </div>
      {otherProjects.length > 0 && (
        <div class="card-grid secondary-grid">
          {otherProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              href={`/projects/${shortSlug(project.slug)}`}
              cover={project.data.cover}
              tags={project.data.tags}
              stack={project.data.stack}
              role={project.data.role}
              github={project.data.github}
              live={project.data.live}
            />
          ))}
        </div>
      )}
    </Section>
    <Section id="connect" title="Connect">
      <div class="connect-grid">
        <a class="connect-card" href={profile.links.github} target="_blank" rel="noreferrer"
           onclick="window.posthog?.capture('connect_card_clicked', { platform: 'github' })">
          <span class="connect-title">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.532 1.033 1.532 1.033.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.03-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.56 9.56 0 0 1 2.504.337c1.909-1.296 2.748-1.026 2.748-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.337-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"/>
            </svg>
            GitHub
          </span>
          <p class="text-secondary">Code, experiments, and open source.</p>
        </a>
        <a class="connect-card" href={profile.links.linkedin} target="_blank" rel="noreferrer"
           onclick="window.posthog?.capture('connect_card_clicked', { platform: 'linkedin' })">
          <span class="connect-title">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5c0 1.38-1.11 2.5-2.48 2.5C1.11 6 0 4.88 0 3.5 0 2.12 1.11 1 2.5 1 3.87 1 4.98 2.12 4.98 3.5ZM0.5 8h4V24h-4V8Zm7.5 0h3.83v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.77 2.65 4.77 6.1V24h-4V8Z"/>
            </svg>
            LinkedIn
          </span>
          <p class="text-secondary">Career timeline and recommendations.</p>
        </a>
        <a class="connect-card" href={profile.links.blog}
           onclick="window.posthog?.capture('connect_card_clicked', { platform: 'blog' })">
          <span class="connect-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 5h12a4 4 0 0 1 4 4v10H8a4 4 0 0 0-4 4V5Z"></path>
              <path d="M8 19V5"></path>
            </svg>
            Blog
          </span>
          <p class="text-secondary">Every post, system deep dive, and note.</p>
        </a>
      </div>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 0;
  }

  :global(html) {
    scroll-behavior: smooth;
  }

  :global(#blog-showcase),
  :global(#tech-stack),
  :global(#career-timeline),
  :global(#recommendations),
  :global(#projects),
  :global(#connect) {
    scroll-margin-top: calc(var(--space-2xl) + var(--space-lg));
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: left;
    padding: var(--space-2xl) var(--space-lg) var(--space-xl);
  }

  .hero-card {
    width: 100%;
    max-width: 880px;
    margin: 0 auto;
  }

  .hero-card-inner.hero-terminal {
    background: #050505;
    border: 1px solid rgba(229, 9, 20, 0.42);
    box-shadow:
      0 28px 70px rgba(0, 0, 0, 0.55),
      inset 0 0 0 1px rgba(242, 242, 239, 0.04);
    border-radius: var(--radius-md);
    padding: var(--space-xl);
    font-family: var(--font-mono);
    text-align: left;
    color: #f2f2ef;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    overflow: hidden;
    position: relative;
  }

  .hero-card-inner.hero-terminal::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(229, 9, 20, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(242, 242, 239, 0.035) 1px, transparent 1px);
    background-size: 100% 22px, 26px 100%;
    pointer-events: none;
  }

  .hero-card-inner.hero-terminal > * {
    position: relative;
    z-index: 1;
  }

  @media (max-width: 900px) {
    .hero-card {
      margin: 0 auto;
    }
  }

  .hero-terminal .terminal-bar {
    padding: 0 0 var(--space-md);
    margin-bottom: var(--space-sm);
    border-bottom-color: rgba(229, 9, 20, 0.25);
  }

  .hero-terminal .terminal-dot {
    border-radius: var(--radius-sm);
  }

  .hero-terminal .dot-red {
    background-color: #e50914;
  }

  .hero-terminal .dot-yellow {
    background-color: #f2f2ef;
  }

  .hero-terminal .dot-green {
    background-color: #555a5f;
  }

  .terminal-muted {
    margin: 0;
    color: rgba(242, 242, 239, 0.58);
    font-size: var(--font-size-sm);
  }

  .terminal-command {
    margin: var(--space-sm) 0 0;
    font-size: var(--font-size-sm);
  }

  .terminal-prompt {
    color: #e50914;
    font-weight: 600;
  }

  .terminal-info {
    margin: 0;
    color: rgba(242, 242, 239, 0.9);
    line-height: 1.7;
  }

  .terminal-socials {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
    gap: var(--space-sm);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .terminal-icon {
    width: 1em;
    height: 1em;
    flex-shrink: 0;
  }

  .terminal-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin: var(--space-xs) 0 var(--space-sm);
  }

  .terminal-button,
  .terminal-action {
    min-height: 2.45rem;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: 0.55rem 0.8rem;
    border: 1px solid rgba(229, 9, 20, 0.55);
    border-radius: var(--radius-sm);
    background: rgba(229, 9, 20, 0.12);
    color: #f2f2ef;
    font-size: var(--font-size-sm);
    line-height: 1.2;
    text-transform: uppercase;
    text-decoration: none;
    text-align: center;
    white-space: nowrap;
    transition:
      background-color var(--transition-fast),
      border-color var(--transition-fast),
      color var(--transition-fast),
      transform var(--transition-fast);
  }

  .terminal-button {
    width: 100%;
  }

  .terminal-button:hover,
  .terminal-action:hover {
    background: #e50914;
    border-color: #e50914;
    color: #ffffff;
    transform: translateY(-1px);
  }

  .terminal-action-light {
    background: #f2f2ef;
    border-color: #f2f2ef;
    color: #050505;
  }

  .terminal-action-light:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #050505;
  }

  .terminal-cursor-line {
    margin-top: 0;
  }

  @media (max-width: 640px) {
    .hero-card-inner.hero-terminal {
      padding: var(--space-lg);
    }

    .terminal-socials {
      grid-template-columns: 1fr;
    }

    .terminal-actions {
      display: grid;
      grid-template-columns: 1fr;
    }

    .terminal-button,
    .terminal-action {
      width: 100%;
    }
  }

  /* ── Tech Stack section ─────────────────────────────────────────────── */
  .tech-summary-pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
  }

  .tech-summary-pills .pill-accent {
    display: inline-block;
    padding: 0.4rem 0.75rem;
    background-color: color-mix(in srgb, var(--color-accent) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-accent) 35%, transparent);
    border-radius: var(--radius-sm);
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    font-weight: 600;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

