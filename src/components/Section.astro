---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
  className?: string;
}

const { id, title, subtitle, className } = Astro.props;
---

<section class={["section", className].filter(Boolean).join(" ")} id={id}>
  <header class="section-header">
    <div class="section-heading">
      <h2 class="section-title">{title}</h2>
      {subtitle && <p class="section-subtitle">{subtitle}</p>}
    </div>
    <div class="section-action">
      <slot name="action" />
    </div>
  </header>
  <div class="section-body">
    <slot />
  </div>
</section>
