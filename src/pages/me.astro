---
import { getCollection } from "astro:content";
import BaseLayout from "../components/BaseLayout.astro";
import Section from "../components/Section.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PostCard from "../components/PostCard.astro";
import { profile } from "../data/profile";
import { testimonials } from "../data/testimonials";

const projects = await getCollection("projects", ({ data }) => !data.draft);
const featuredProjects = projects.filter((project) => project.data.showcase);
const otherProjects = projects.filter((project) => !project.data.showcase);

const showcasePosts = (
  await getCollection("posts", ({ data }) => !data.draft && data.showcase)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date): string {
  return new Intl.DateTimeFormat("en-US", {
    year: "numeric",
    month: "short",
    day: "numeric",
  }).format(date);
}

function shortSlug(slug: string): string {
  return slug.split("/").pop() || slug;
}
---

<BaseLayout title="Ayman Patel" description="Portfolio and selected writing." navVariant="me">
  <div class="hero">
    <div class="container hero-grid">
      <div class="hero-top">
        <h3 class="hero-title">{profile.name}</h3>
      </div>
      <div class="hero-card">
        <div class="hero-card-inner hero-terminal">
          <p class="terminal-muted">[system] boot sequence complete.</p>
          <p class="terminal-muted">[system] kernel v24.07 loaded.</p>
          <p class="terminal-command">
            <span class="terminal-prompt">&gt;</span> whoami
          </p>
          <p class="terminal-info">
            [info] {profile.role} {profile.tagline}
          </p>
          <p class="terminal-command">
            <span class="terminal-prompt">&gt;</span> socials
          </p>
          <div class="terminal-socials">
            <a
              class="terminal-link"
              href={profile.links.github}
              target="_blank"
              rel="noreferrer"
            >
              [socials] github
            </a>
            <a
              class="terminal-link"
              href={profile.links.linkedin}
              target="_blank"
              rel="noreferrer"
            >
              [socials] linkedin
            </a>
          </div>
          <p class="terminal-command">
            <span class="terminal-prompt">&gt;</span> _
          </p>
          <div class="hero-actions">
            <a class="button cta-dark" href={profile.links.blog}>
              Blog
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
            <a class="button cta-dark" href="/me#projects">
              Projects
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
            <a class="button cta-light" href={profile.links.cv} target="_blank" rel="noreferrer">
              CV
              <span class="button-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="container content-stack">

    <Section title="Blog Showcase" subtitle="Deep dives, systems thinking, and engineering notes.">
      <div class="card-grid">
        {showcasePosts.map((post) => (
          <PostCard
            title={post.data.title}
            description={post.data.description}
            href={`/posts/${shortSlug(post.slug)}`}
            cover={post.data.cover}
            date={formatDate(post.data.date)}
            tags={post.data.tags}
          />
        ))}
      </div>
      <div class="section-cta">
        <a class="button cta-dark" href={profile.links.blog}>
          Read the blog
          <span class="button-arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </Section>

  </div>

  <section class="tl-section" id="career-timeline">
    <div class="tl-wrapper">
      <div class="tl-header">
        <h2 class="tl-section-title">Timeline</h2>
        <p class="tl-section-sub">Education &amp; experience, newest first.</p>
      </div>
      <div class="tl-track">
        <div class="tl-center-line" aria-hidden="true"></div>
        {profile.timeline.map((item, i) => (
          <div class="tl-entry" data-tl-entry data-side={i % 2 === 0 ? 'right' : 'left'}>
            <div class="tl-card-wrap">
              <div class="tl-card">
                <h3 class="tl-card-title">{item.title}</h3>
                <p class="tl-card-org">{item.org}</p>
                <p class="tl-card-dates">{item.start}&nbsp;–&nbsp;{item.end}</p>
                <p class="tl-card-desc">{item.description}</p>
              </div>
            </div>
            <div class="tl-node-wrap">
              <div class="tl-node">
                <span class="tl-node-num">{i + 1}</span>
              </div>
            </div>
            <div class="tl-spacer"></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="container content-stack">

    <Section
      className="recommendations-section"
      title="Recommendations"
      subtitle="LinkedIn-style feedback from colleagues and partners."
    >
      <input
        class="testimonials-toggle"
        type="checkbox"
        id="toggle-testimonials"
      />
      <div class="testimonials-grid">
        {testimonials.map((item) => (
          <article class="testimonial-card">
            <div class="testimonial-header">
              <div class="testimonial-avatar">{item.initials}</div>
              <div class="testimonial-identity">
                <p class="testimonial-name">{item.name}</p>
                <p class="testimonial-role text-secondary">{item.role}</p>
                <p class="testimonial-meta">{item.relationship}</p>
              </div>
              <span class="pill pill-muted">{item.date}</span>
            </div>
            <p class="testimonial-quote">"{item.quote}"</p>
            <div class="testimonial-footer">
              <span class="testimonial-source">LinkedIn recommendation</span>
            </div>
          </article>
        ))}
      </div>
      <div class="testimonials-actions">
        <label class="button ghost testimonials-toggle-btn" for="toggle-testimonials">
          <span class="label-more">Show more</span>
          <span class="label-less">Show less</span>
        </label>
      </div>
    </Section>
    <Section id="projects" title="Projects" subtitle="Work that goes deep.">
      <div class="card-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            description={project.data.description}
            href={`/projects/${shortSlug(project.slug)}`}
            cover={project.data.cover}
            tags={project.data.tags}
            stack={project.data.stack}
            role={project.data.role}
            github={project.data.github}
            live={project.data.live}
          />
        ))}
      </div>
      {otherProjects.length > 0 && (
        <div class="card-grid secondary-grid">
          {otherProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              href={`/projects/${shortSlug(project.slug)}`}
              cover={project.data.cover}
              tags={project.data.tags}
              stack={project.data.stack}
              role={project.data.role}
              github={project.data.github}
              live={project.data.live}
            />
          ))}
        </div>
      )}
    </Section>
    <Section title="Connect">
      <div class="connect-grid">
        <a class="connect-card" href={profile.links.github} target="_blank" rel="noreferrer">
          <span class="connect-title">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.532 1.033 1.532 1.033.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.03-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.56 9.56 0 0 1 2.504.337c1.909-1.296 2.748-1.026 2.748-1.026.546 1.378.203 2.397.1 2.65.64.7 1.028 1.595 1.028 2.688 0 3.848-2.338 4.695-4.566 4.944.359.309.678.92.678 1.855 0 1.337-.012 2.415-.012 2.743 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2Z"/>
            </svg>
            GitHub
          </span>
          <p class="text-secondary">Code, experiments, and open source.</p>
        </a>
        <a class="connect-card" href={profile.links.linkedin} target="_blank" rel="noreferrer">
          <span class="connect-title">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4.98 3.5c0 1.38-1.11 2.5-2.48 2.5C1.11 6 0 4.88 0 3.5 0 2.12 1.11 1 2.5 1 3.87 1 4.98 2.12 4.98 3.5ZM0.5 8h4V24h-4V8Zm7.5 0h3.83v2.2h.05c.53-1 1.83-2.2 3.77-2.2 4.03 0 4.77 2.65 4.77 6.1V24h-4v-7.6c0-1.81-.03-4.14-2.52-4.14-2.53 0-2.92 1.98-2.92 4.02V24h-4V8Z"/>
            </svg>
            LinkedIn
          </span>
          <p class="text-secondary">Career timeline and recommendations.</p>
        </a>
        <a class="connect-card" href={profile.links.blog}>
          <span class="connect-title">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 5h12a4 4 0 0 1 4 4v10H8a4 4 0 0 0-4 4V5Z"></path>
              <path d="M8 19V5"></path>
            </svg>
            Blog
          </span>
          <p class="text-secondary">Every post, system deep dive, and note.</p>
        </a>
      </div>
    </Section>
  </div>
</BaseLayout>

<style>
  .hero {
    padding: 0;
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
    gap: var(--space-2xl);
    padding: var(--space-2xl) 0 var(--space-xl);
  }

  .hero-top {
    width: 100%;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-lg);
  }

  .hero-title {
    margin: 0;
    font-size: clamp(1.8rem, 6vw, 4rem);
  }

  .hero-actions {
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .hero-card {
    width: 100%;
    max-width: 820px;
  }

  .hero-card-inner.hero-terminal {
    background: #0b1220;
    border: 1px solid rgba(148, 163, 184, 0.2);
    box-shadow: 0 24px 50px rgba(7, 13, 24, 0.45);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    font-family: var(--font-mono);
    text-align: left;
    color: #d6dde8;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  @media (max-width: 900px) {
    .hero-top {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: center;
    }

    .hero-actions {
      justify-content: center;
    }

    .hero-card {
      margin: 0 auto;
    }
  }

  .terminal-muted {
    margin: 0;
    color: rgba(148, 163, 184, 0.8);
    font-size: var(--font-size-sm);
  }

  .terminal-command {
    margin: var(--space-sm) 0 0;
    font-size: var(--font-size-sm);
  }

  .terminal-prompt {
    color: #38bdf8;
    font-weight: 600;
  }

  .terminal-info {
    margin: 0;
    color: rgba(226, 232, 240, 0.9);
    line-height: 1.7;
  }

  .terminal-socials {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .terminal-link {
    color: #a5b4fc;
    text-decoration: none;
  }

  .terminal-link:hover {
    color: #e0e7ff;
  }

  .section-cta {
    display: flex;
    justify-content: center;
    margin-top: var(--space-lg);
  }

  .button-arrow {
    margin-left: 0.35rem;
    font-size: 1.05em;
  }

  [data-theme='dark'] .cta-dark {
    background-color: #0f1115;
    color: #f2f4f8;
    border-color: #2a2f36;
  }

  [data-theme='dark'] .cta-dark:hover {
    background-color: #171a1f;
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.3);
  }

  [data-theme='dark'] .cta-light {
    background-color: #f2f4f8;
    color: #0f1115;
    border-color: #f2f4f8;
  }

  [data-theme='dark'] .cta-light:hover {
    background-color: #ffffff;
  }

  /* ── Timeline section ──────────────────────────────────────────────── */
  .tl-section {
    padding: 5rem 0 6rem;
  }

  .tl-wrapper {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--space-xl);
  }

  .tl-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .tl-section-title {
    color: var(--color-text);
    margin: 0 0 var(--space-sm);
    font-size: var(--font-size-3xl);
  }

  .tl-section-sub {
    color: var(--color-text-secondary);
    margin: 0;
    font-size: var(--font-size-base);
  }

  /* ── Track & spine ──────────────────────────────────────────────────── */
  .tl-track {
    position: relative;
  }

  .tl-center-line {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      transparent,
      var(--color-border) 8%,
      var(--color-border) 92%,
      transparent
    );
    transform: translateX(-50%);
  }

  /* ── Entry ──────────────────────────────────────────────────────────── */
  .tl-entry {
    display: grid;
    grid-template-columns: 1fr 80px 1fr;
    margin-bottom: 3.5rem;
    opacity: 0.2;
    transition: opacity 0.5s ease;
    align-items: start;
  }

  .tl-entry:last-child {
    margin-bottom: 0;
  }

  .tl-entry.is-active {
    opacity: 1;
  }

  /* ── Card positioning by data-side ──────────────────────────────────── */
  .tl-card-wrap {
    transition: transform 0.5s ease;
  }

  .tl-entry[data-side="right"] .tl-card-wrap {
    grid-column: 3;
    grid-row: 1;
    padding-left: var(--space-xl);
    transform: translateX(24px);
  }
  .tl-entry.is-active[data-side="right"] .tl-card-wrap {
    transform: translateX(0);
  }

  .tl-entry[data-side="right"] .tl-node-wrap {
    grid-column: 2;
    grid-row: 1;
  }

  .tl-entry[data-side="right"] .tl-spacer {
    grid-column: 1;
    grid-row: 1;
  }

  .tl-entry[data-side="left"] .tl-card-wrap {
    grid-column: 1;
    grid-row: 1;
    padding-right: var(--space-xl);
    transform: translateX(-24px);
  }
  .tl-entry.is-active[data-side="left"] .tl-card-wrap {
    transform: translateX(0);
  }

  .tl-entry[data-side="left"] .tl-node-wrap {
    grid-column: 2;
    grid-row: 1;
  }

  .tl-entry[data-side="left"] .tl-spacer {
    grid-column: 3;
    grid-row: 1;
  }

  /* ── Node (numbered dot) ────────────────────────────────────────────── */
  .tl-node-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 0.9rem;
  }

  .tl-node {
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 2px solid var(--color-border);
    background-color: var(--color-bg-secondary);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    z-index: 2;
    transition: border-color 0.5s ease, box-shadow 0.5s ease, background-color 0.5s ease;
  }

  .tl-entry.is-active .tl-node {
    border-color: var(--color-accent);
    background-color: var(--color-accent);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--color-accent) 15%, transparent);
  }

  .tl-node-num {
    font-size: var(--font-size-xs);
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--color-text-secondary);
    transition: color 0.5s ease;
    user-select: none;
  }

  .tl-entry.is-active .tl-node-num {
    color: #fff;
  }

  /* ── Card ───────────────────────────────────────────────────────────── */
  .tl-card {
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: border-color 0.5s ease, box-shadow 0.5s ease;
  }

  .tl-entry.is-active .tl-card {
    border-color: var(--color-accent);
    box-shadow: 0 8px 32px color-mix(in srgb, var(--color-accent) 10%, transparent);
  }

  .tl-card-title {
    margin: 0 0 var(--space-xs);
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text);
  }

  .tl-card-org {
    margin: 0 0 0.2rem;
    font-size: var(--font-size-base);
    color: var(--color-accent);
    font-weight: 500;
  }

  .tl-card-dates {
    margin: 0 0 var(--space-md);
    font-size: var(--font-size-sm);
    font-family: var(--font-mono);
    color: var(--color-text-secondary);
  }

  .tl-card-desc {
    margin: 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }

  /* ── Mobile ─────────────────────────────────────────────────────────── */
  @media (max-width: 640px) {
    .tl-entry {
      grid-template-columns: 44px 1fr;
    }

    .tl-entry[data-side="right"] .tl-card-wrap,
    .tl-entry[data-side="left"] .tl-card-wrap {
      grid-column: 2;
      grid-row: 1;
      padding-left: var(--space-md);
      padding-right: 0;
    }

    .tl-entry[data-side="right"] .tl-node-wrap,
    .tl-entry[data-side="left"] .tl-node-wrap {
      grid-column: 1;
      grid-row: 1;
    }

    .tl-entry[data-side="right"] .tl-spacer,
    .tl-entry[data-side="left"] .tl-spacer {
      display: none;
    }

    .tl-center-line {
      left: 22px;
      transform: none;
    }

    .tl-entry[data-side="right"] .tl-card-wrap,
    .tl-entry[data-side="left"] .tl-card-wrap {
      transform: none !important;
    }
  }
</style>

<script>
  (() => {
    /* ── Scroll-activated entries ──────────────────────────────────────── */
    const items = document.querySelectorAll<HTMLElement>('[data-tl-entry]');
    if (!items.length) return;

    items[0].classList.add('is-active');

    const obs = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            items.forEach((el) => el.classList.remove('is-active'));
            entry.target.classList.add('is-active');
          }
        });
      },
      { rootMargin: '-20% 0px -50% 0px', threshold: 0 }
    );

    items.forEach((item) => obs.observe(item));
  })();
</script>
