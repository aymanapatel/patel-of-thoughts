---
interface Props {
  id?: string;
  title: string;
  subtitle?: string;
}

const { id, title, subtitle } = Astro.props;
---

<section class="section" id={id}>
  <header class="section-header">
    <h2 class="section-title">{title}</h2>
    {subtitle && <p class="section-subtitle">{subtitle}</p>}
  </header>
  <div class="section-body">
    <slot />
  </div>
</section>
